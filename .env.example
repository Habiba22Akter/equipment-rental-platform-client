# ---- Better Auth ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Use http://localhost:3000 locally and your live URL on Vercel.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only credentials for disposable demo accounts. The app creates each
# account on first demo sign-in. Use a password with uppercase/lowercase and 6+ chars.
DEMO_CUSTOMER_EMAIL=demo.customer@example.com
DEMO_CUSTOMER_PASSWORD=DemoCustomer123
DEMO_OWNER_EMAIL=demo.owner@example.com
DEMO_OWNER_PASSWORD=DemoOwner123
DEMO_ADMIN_EMAIL=demo.admin@example.com
DEMO_ADMIN_PASSWORD=DemoAdmin123

# Optional comma-separated extra origins (preview deployments, custom domains)
TRUSTED_ORIGINS=

# ---- MongoDB ----
# Never commit real credentials. Add this in Vercel → Settings → Environment Variables.
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=equipment-rental-platform

# ---- Google OAuth ----
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- GitHub OAuth ----
# Authorised callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- ImgBB (equipment and profile image uploads) ----
# Get a key at https://api.imgbb.com/. Kept server-side only.
IMGBB_API_KEY=

# ---- Equipment API (Express server) ----
# Local server URL; use your deployed API URL in production.
EQUIPMENT_API_URL=http://localhost:5001
# Optional shared secret. Must match INTERNAL_API_KEY on the Express server.
EQUIPMENT_API_KEY=


# Google Authorized redirect URI: https://equipment-rental-platform-client-six.vercel.app/api/auth/callback/google
# GitHub Authorization callback URL: https://equipment-rental-platform-client-six.vercel.app/api/auth/callback/github

